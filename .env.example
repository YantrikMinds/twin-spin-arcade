# Port for backend server
PORT=5000

# JWT secret key for signing session tokens (generate using: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_string_before_deploying

# Google Sheets Integration (Optional - if blank, local JSON fallback data/store.json is used)
# 1. Your Google Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEET_ID=

# 2. Path to Google Service Account Credentials JSON file (relative to server/ or absolute)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./config/service-account.json

# Default Thermal Printer Paper Width ('58mm' or '80mm')
DEFAULT_PRINTER_WIDTH=58mm
